# Copy this file to `.env` at the repository root, then edit values as needed.

# Authentication mode ("LDAP" or "OAUTH")
PIRO_AUTH_MODE=OAUTH

# Mock OAuth group claim + API allowed-groups check
MOCK_OAUTH_AD_GROUP=GS-CC-LABMD-APPS-Piro-DEV
OIDC_ALLOWED_GROUPS=GS-CC-LABMD-APPS-Piro-DEV

# Email domains allowed to sign in (comma-separated). The local mock IdP
# issues usernames at test.local; servers should use the organization domain.
OIDC_ALLOWED_EMAIL_DOMAINS=test.local

# Local sample-data behavior
PIRO_BOOTSTRAP_DB=true
PIRO_FORCE_RESET=false
PIRO_LOAD_SAMPLE_DATA=false

# API connection overrides (uncomment to point at shared/non-local services)
# MSSQL_SERVER=sqlserver
# MSSQL_DB=PIRO
# MSSQL_USER=sa
# PIRO_MSSQL_SA_PASSWORD=P1ro!LocalDev
# SOLR_URL=http://solr:8983/solr
# SOLR_USER_NAME=
# SOLR_USER_PASSWORD=

# LDAP settings
# AD_LDAP_PATH=
# AD_SECURITY_GROUP=
# AD_DOMAIN=

# Airflow integration
# AIRFLOW_CERTIFICATE=
# AIRFLOW_DAG_COHORT_LOADER_URL=
# AIRFLOW_USERNAME=
# AIRFLOW_PASSWORD=

# External linked-order API (deploy piro-sql/deploy_external_api.sql first).
# Independent of PIRO_AUTH_MODE. See piro-api/README_EXTERNAL_API.md.
EXTERNAL_API_ENABLED=false
EXTERNAL_API_MAX_CASES=100
EXTERNAL_API_MAX_RECORDS=5000
EXTERNAL_API_DAILY_RECORDS=50000
EXTERNAL_API_REQUESTS_PER_MINUTE=30
EXTERNAL_API_MAX_CONCURRENT=2
EXTERNAL_API_QUERY_TIMEOUT_SECONDS=30
EXTERNAL_API_MAX_BODY_BYTES=65536
