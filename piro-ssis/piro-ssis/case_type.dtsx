    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{34539912-175D-4D9B-9226-D8815963550E}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;Insert into SSIS_LogCustom Values ('&quot; + @[System::MachineName] + &quot;' , '&quot; + @[System::PackageName] + &quot;', '', '', 'query', '&quot; + REPLACE(@[User::query], &quot;'&quot;, &quot;''&quot;)  + &quot;', getdate())&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="log_query">
      <DTS:VariableValue
        DTS:DataType="8">Insert into SSIS_LogCustom Values ('[computer name]' , 'case_type', '', '',
        'query', 'SELECT CT.*, TC.TITLE as TYPE_CASE, WT.TITLE as WORKLIST_TYPE FROM
        CLARITY.AP_CASE_TYPES CT
        LEFT JOIN CLARITY.ZC_TYPE_CASE TC ON CT.TYPE_CASE_C = TC.TYPE_CASE_C
        LEFT JOIN CLARITY.ZC_AP_WORKLIST_TYP WT ON CT.AP_WORKLIST_TYPE_C = WT.AP_WORKLIST_TYP_C',
        getdate())</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{530F3973-9940-4BDB-8819-DD21CA945509}"
      DTS:EvaluateAsExpression="True"
