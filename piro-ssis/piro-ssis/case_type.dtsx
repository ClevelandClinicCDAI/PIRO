      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="log_start">
      <DTS:VariableValue
        DTS:DataType="8">Insert into SSIS_LogCustom Values ('[computer name]' , 'case_type', '', '',
        'start', '', getdate())</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{24A09F53-D826-4229-94EB-87A6DEA97827}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;SELECT CT.*, TC.TITLE as TYPE_CASE, WT.TITLE as WORKLIST_TYPE FROM CLARITY.AP_CASE_TYPES CT&#xA;LEFT JOIN CLARITY.ZC_TYPE_CASE TC ON CT.TYPE_CASE_C = TC.TYPE_CASE_C&#xA;LEFT JOIN CLARITY.ZC_AP_WORKLIST_TYP WT ON CT.AP_WORKLIST_TYPE_C = WT.AP_WORKLIST_TYP_C&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="query">
      <DTS:VariableValue
        DTS:DataType="8">SELECT CT.*, TC.TITLE as TYPE_CASE, WT.TITLE as WORKLIST_TYPE FROM
        CLARITY.AP_CASE_TYPES CT
        LEFT JOIN CLARITY.ZC_TYPE_CASE TC ON CT.TYPE_CASE_C = TC.TYPE_CASE_C
        LEFT JOIN CLARITY.ZC_AP_WORKLIST_TYP WT ON CT.AP_WORKLIST_TYPE_C = WT.AP_WORKLIST_TYP_C</DTS:VariableValue>
    </DTS:Variable>
