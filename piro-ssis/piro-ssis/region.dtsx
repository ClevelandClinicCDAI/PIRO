    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{48F802EB-2327-4D37-9BC4-8A1C5848D7E3}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;Insert into SSIS_LogCustom Values ('&quot; + @[System::MachineName] + &quot;' , '&quot; + @[System::PackageName] + &quot;', '', '', 'query', '&quot; + REPLACE(@[User::query], &quot;'&quot;, &quot;''&quot;)  + &quot;', getdate())&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="log_query">
      <DTS:VariableValue
        DTS:DataType="8">Insert into SSIS_LogCustom Values ('[computer name]' , 'region', '', '',
        'query', 'SELECT
        USER_ID K_EMPLOYEE_KEY,
        USER_ID, EPIC_EMP_ID INTERNAL_USER_ID,
        NAME EMPLOYEE_NM,
        EFF_FROM_DATE EFF_FROM_DT,
        EFF_TO_DATE EFF_TO_DT from CLARITY.CLARITY_EMP
        ', getdate())</DTS:VariableValue>
    </DTS:Variable>
