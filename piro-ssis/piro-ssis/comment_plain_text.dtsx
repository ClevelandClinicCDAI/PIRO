    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{085DF3AE-0ABA-4E4C-8264-2C516B5340F3}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;Insert into SSIS_LogCustom Values ('&quot; + @[System::MachineName] + &quot;' , '&quot; + @[System::PackageName] + &quot;', '', '', 'end', '', getdate())&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="log_end">
      <DTS:VariableValue
        DTS:DataType="8">Insert into SSIS_LogCustom Values ('[computer name]' ,
        'comment_plain_text', '', '', 'end', '', getdate())</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{F7C1DD40-A1D8-478C-BE31-136B931EEB84}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;Insert into SSIS_LogCustom Values ('&quot; + @[System::MachineName] + &quot;' , '&quot; + @[System::PackageName] + &quot;', '', '', 'query', '&quot; + REPLACE(@[User::query], &quot;'&quot;, &quot;''&quot;)  + &quot;', getdate())&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="log_query">
      <DTS:VariableValue
        DTS:DataType="8">Insert into SSIS_LogCustom Values ('[computer name]' ,
        'comment_plain_text', '', '', 'query', 'Select 0 RANK_RES_GROUP
        ,RES_COMPONENTS.COMPONENT_ID, COMP.NAME COMP_NAME,
        '''' COMMENT_TYPE,
        COMPONENT_INST, COMMENTS.RESULT_ID,
        COMMENTS.GROUP_LINE, COMMENTS.VALUE_LINE, COMMENTS.MULT_LN_VAL_STORAGE,
        RES_SPE.SPECIMENS_ID, REQ_SPE.REQUISITION_ID
        from CLARITY.RES_VAL_DATA_RM COMMENTS
        JOIN CLARITY.RES_VAL_PTR_RM RES_VAL_PTR_RM ON COMMENTS.RESULT_ID = RES_VAL_PTR_RM.RESULT_ID
        AND COMMENTS.GROUP_LINE = RES_VAL_PTR_RM.CMP_MULTILINE_VALUE
        JOIN CLARITY.RES_COMPONENTS RES_COMPONENTS ON RES_VAL_PTR_RM.RESULT_ID =
        RES_COMPONENTS.RESULT_ID AND RES_VAL_PTR_RM.GROUP_LINE = RES_COMPONENTS.LINE
        JOIN CLARITY.RES_SPECIMENS RES_SPE on COMMENTS.RESULT_ID = RES_SPE.RESULT_ID
        JOIN CLARITY.REQ_SPECIMEN REQ_SPE on RES_SPE.SPECIMENS_ID = REQ_SPE.REQ_SPECIMEN_ID
        JOIN CLARITY.CLARITY_COMPONENT COMP ON RES_COMPONENTS.COMPONENT_ID = COMP.COMPONENT_ID
        WHERE RES_SPE.LINE = 1
        AND COMPONENT_INST &gt;= TO_DATE(''2025-01-31'',''yyyy-mm-dd'') AND COMPONENT_INST&lt;
        TO_DATE(''2025-12-31'',''yyyy-mm-dd'')', getdate())</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{8168EA47-69FC-4262-92FF-A33BC40EE103}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;Insert into SSIS_LogCustom Values ('&quot; + @[System::MachineName] + &quot;' , '&quot; + @[System::PackageName] + &quot;', '', '', 'start', '', getdate())&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="log_start">
      <DTS:VariableValue
        DTS:DataType="8">Insert into SSIS_LogCustom Values ('[computer name]' ,
        'comment_plain_text', '', '', 'start', '', getdate())</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{2929F0A5-9B18-4797-B912-E007F8278F74}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;Select 0 RANK_RES_GROUP ,RES_COMPONENTS.COMPONENT_ID, COMP.NAME COMP_NAME, &#xA;  &quot; +   (@[User::query_comment_type_clause]  == &quot;&quot; ? &quot;''&quot; : @[User::query_comment_type_clause] ) + &quot; COMMENT_TYPE, &#xA;COMPONENT_INST, COMMENTS.RESULT_ID,&#xA;COMMENTS.GROUP_LINE, COMMENTS.VALUE_LINE, COMMENTS.MULT_LN_VAL_STORAGE, RES_SPE.SPECIMENS_ID, REQ_SPE.REQUISITION_ID &#xA;from CLARITY.RES_VAL_DATA_RM COMMENTS&#xA;JOIN CLARITY.RES_VAL_PTR_RM  RES_VAL_PTR_RM ON COMMENTS.RESULT_ID = RES_VAL_PTR_RM.RESULT_ID AND COMMENTS.GROUP_LINE = RES_VAL_PTR_RM.CMP_MULTILINE_VALUE&#xA;JOIN CLARITY.RES_COMPONENTS  RES_COMPONENTS ON RES_VAL_PTR_RM.RESULT_ID = RES_COMPONENTS.RESULT_ID AND RES_VAL_PTR_RM.GROUP_LINE = RES_COMPONENTS.LINE&#xA;JOIN CLARITY.RES_SPECIMENS RES_SPE on COMMENTS.RESULT_ID = RES_SPE.RESULT_ID&#xA;JOIN CLARITY.REQ_SPECIMEN REQ_SPE on RES_SPE.SPECIMENS_ID = REQ_SPE.REQ_SPECIMEN_ID&#xA;JOIN CLARITY.CLARITY_COMPONENT COMP ON RES_COMPONENTS.COMPONENT_ID = COMP.COMPONENT_ID&#xA; WHERE RES_SPE.LINE = 1 &#xA;&quot; &#xA; + (@[User::row_num] == &quot;&quot; ?  &quot;&quot; : &quot; AND ROWNUM &lt; &quot; +  @[User::row_num]) &#xA; +  (@[User::start_date] == &quot;&quot; ?  &quot;&quot; : &quot; AND  COMPONENT_INST &gt;= TO_DATE('&quot; + @[User::start_date] + &quot;','yyyy-mm-dd')&quot;) + (@[User::end_date] == &quot;&quot; ?  &quot;&quot; : &quot; AND  COMPONENT_INST&lt; TO_DATE('&quot; + @[User::end_date] + &quot;','yyyy-mm-dd')&quot;)"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="query">
      <DTS:VariableValue
        DTS:DataType="8">Select 0 RANK_RES_GROUP ,RES_COMPONENTS.COMPONENT_ID, COMP.NAME COMP_NAME,
        '' COMMENT_TYPE,
        COMPONENT_INST, COMMENTS.RESULT_ID,
        COMMENTS.GROUP_LINE, COMMENTS.VALUE_LINE, COMMENTS.MULT_LN_VAL_STORAGE,
        RES_SPE.SPECIMENS_ID, REQ_SPE.REQUISITION_ID
        from CLARITY.RES_VAL_DATA_RM COMMENTS
        JOIN CLARITY.RES_VAL_PTR_RM RES_VAL_PTR_RM ON COMMENTS.RESULT_ID = RES_VAL_PTR_RM.RESULT_ID
        AND COMMENTS.GROUP_LINE = RES_VAL_PTR_RM.CMP_MULTILINE_VALUE
        JOIN CLARITY.RES_COMPONENTS RES_COMPONENTS ON RES_VAL_PTR_RM.RESULT_ID =
        RES_COMPONENTS.RESULT_ID AND RES_VAL_PTR_RM.GROUP_LINE = RES_COMPONENTS.LINE
        JOIN CLARITY.RES_SPECIMENS RES_SPE on COMMENTS.RESULT_ID = RES_SPE.RESULT_ID
        JOIN CLARITY.REQ_SPECIMEN REQ_SPE on RES_SPE.SPECIMENS_ID = REQ_SPE.REQ_SPECIMEN_ID
        JOIN CLARITY.CLARITY_COMPONENT COMP ON RES_COMPONENTS.COMPONENT_ID = COMP.COMPONENT_ID
        WHERE RES_SPE.LINE = 1
        AND COMPONENT_INST &gt;= TO_DATE('2025-01-31','yyyy-mm-dd') AND COMPONENT_INST&lt;
        TO_DATE('2025-12-31','yyyy-mm-dd')</DTS:VariableValue>
    </DTS:Variable>
