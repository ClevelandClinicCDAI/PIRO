PROJECT_NAME="PIRO"
PROJECT_VERSION="1.0.0"
ACCESS_TOKEN_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES="300"
ACCESS_TOKEN_ALGORITHM="HS256"
SLIDEROOM_ACCESS_TOKEN_EXPIRE_MINUTES="1440"
MSSQL_WINDOW_AUTH="False"
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_SERVER=
MSSQL_DB=
MSSQL_DRIVER="SQL Server"
DATABASE="MSSQL"
API_CORS="http://localhost:4201"
SOLR_URL="http://localhost:8983/solr"
SOLR_CORE="PIROCase"
SOLR_SUGGEST_COMMENT="PIROSuggestComment/suggest?q="
SOLR_SUGGEST_STAFF="PIROSuggestStaff/suggest?q="
SOLR_SUGGEST_CASE="PIROSuggestCase/suggest?q="
SOLR_USER_NAME=
SOLR_USER_PASSWORD=
AD_LDAP_PATH=
AD_SECURITY_GROUP=
AD_DOMAIN=
# Authentication mode. "LDAP" (default) uses the existing corporate-AD
# flow; "OAUTH" validates an OIDC id_token posted by the client.
AUTH_MODE="LDAP"
# OIDC settings (only used when AUTH_MODE="OAUTH"):
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_ALGORITHMS="RS256"
# Comma-separated group names; membership in ANY grants access.
OIDC_ALLOWED_GROUPS=
# Comma-separated email domains allowed to sign in (e.g. "ccf.org").
# Required when AUTH_MODE="OAUTH"; the API refuses to start without it.
OIDC_ALLOWED_EMAIL_DOMAINS=
OIDC_NUID_CLAIM="preferred_username"
OIDC_GIVEN_NAME_CLAIM="given_name"
OIDC_FAMILY_NAME_CLAIM="family_name"
OIDC_GROUPS_CLAIM="groups"
OIDC_CLOCK_SKEW_SECONDS="60"
# Turn on/off creation of new users automatically via OAuth
# Should be set to "false" on localhost to prevent accidental record creation.
OAUTH_AUTO_PROVISION_USERS="false"
EXCEL_Template_DIRECTORY="backend/template/"
EXCEL_Output_DIRECTORY="excel/"
EXCEL_Cohort_MRN_Template_FILE="PIRO_Cohort_MRN_Template.xlsx"
EXCEL_Cohort_Case_Template_FILE="PIRO_Cohort_Case_Template.xlsx"
EXCEL_Cohort_EID_Template_FILE="PIRO_Cohort_EID_Template.xlsx"
DATAREQUEST_EMAIL_Template_DIRECTORY="backend/template/"
DATAREQUEST_EMAIL_Template_FILE="PIRO_DATA_REQUEST_Template.html"
DATAREQUEST_EMAIL_SUBJECT="PRIO-DEV: Data Request - {{RequestedBy}}"
DATAREQUEST_EMAIL_TO=
DATAREQUEST_EMAIL_CC=
DATAREQUEST_EMAIL_ENABLE="True"
EMAIL_SMTP_SERVER=
EMAIL_FROM=
SQLALCHEMY_TRACK_MODIFICATIONS="False"
AIRFLOW_HEADER_AUTH=
AIRFLOW_DAG_COHORT_LOADER_URL=
AIRFLOW_CERTIFICATE=
CONCENTRIQ_WEBHOOK_SECRET=
CONCENTRIQ_URL=

# Extraction Suite LLM settings
# LLM_PROVIDER: ollama (default, HIPAA-safe local) | openai | anthropic | generic | azure
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2
LLM_API_KEY=
# Azure only: API version (default: 2024-02-01)
LLM_API_VERSION=
# External providers — only use with a valid Business Associate Agreement (BAA)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# External integration API; independent of AUTH_MODE. Deploy SQL tables first.
EXTERNAL_API_ENABLED=false
EXTERNAL_API_MAX_CASES=100
EXTERNAL_API_MAX_RECORDS=5000
EXTERNAL_API_DAILY_RECORDS=50000
EXTERNAL_API_REQUESTS_PER_MINUTE=30
EXTERNAL_API_MAX_CONCURRENT=2
EXTERNAL_API_QUERY_TIMEOUT_SECONDS=30
EXTERNAL_API_MAX_BODY_BYTES=65536
